# Copy to .env.local and fill in.

# MySQL (same database the PHP site used — see db/schema.sql)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=w3tech

# Outgoing mail. If SMTP_HOST is empty, the server's local sendmail is used (like PHP's mail()).
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=info@w3tec.com
# Receives "new enquiry" notifications.
MAIL_ADMIN=info@w3tec.com

# Signs the admin session cookie. Generate with: openssl rand -base64 32
SESSION_SECRET=

# The PHP site let anyone create an admin account. Set to true only while creating one.
ALLOW_ADMIN_REGISTRATION=false

# Public address of the site, used for canonical URLs, the sitemap and social previews.
NEXT_PUBLIC_SITE_URL=https://w3tec.com
